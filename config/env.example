# .env.local の項目（名前だけ。値は書かない）
# python tools/team.py env --role builder|member --team <チームの名前> が、値を入れた .env.local を Repo 直下に作る（--out PATH で別の場所に書き出せる）。Git には入らない
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
# admin（構築する人）か query（メンバー）
AZURE_SEARCH_KEY_ROLE=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CHAT_MODEL=
AZURE_OPENAI_REASONING_EFFORT=
EMBEDDING_DIMENSIONS=
# 次の2つは構築する人（builder）の .env.local だけ。メンバーの .env.local には入らない（人事の資料を Storage に入れるため）
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
